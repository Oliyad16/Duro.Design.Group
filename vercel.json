{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/Duro%20Group%20Website/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/Duro Group Website/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/site/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/site/$1"
    }
  ]
}
